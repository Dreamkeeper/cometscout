# Failure alert: systemd starts this when a jobpilot unit fails (OnFailure=jobpilot-failure@%n.service in
# jobpilot.service). %i is the name of the unit that failed. node cli.mjs timer installs it with the paths filled in.
[Unit]
Description=jobpilot failure alert for %i

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStart=@NODE@ @ROOT@/cli.mjs notify "jobpilot: %i failed, see journalctl --user -u %i"

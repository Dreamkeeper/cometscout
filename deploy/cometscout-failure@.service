# Failure alert: systemd starts this when a CometScout unit fails (OnFailure=cometscout-failure@%n.service in
# cometscout.service). %i is the name of the unit that failed. node cli.mjs timer installs it with the paths filled in.
[Unit]
Description=CometScout failure alert for %i

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStart=@NODE@ @CODE@/cli.mjs notify "cometscout: %i failed, see journalctl --user -u %i"

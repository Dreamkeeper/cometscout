{
  "_comment": "Copy to settings.json. Secrets (tokens) go in .env, never here. Every source is optional: enable what you have.",
  "candidate_name": "Alex Rivera",
  "timezone": "Europe/Madrid",
  "run_time": "18:00",
  "llm": {
    "provider": "claude",
    "model": "sonnet",
    "pack_model": "opus",
    "timeout_sec": 300
  },
  "decoder": { "cap": 30 },
  "picks": { "per_day": 2, "window_days": 14, "max_shown": 3, "exclude_location_regex": "" },
  "sources": {
    "ats_boards": {
      "enabled": true,
      "companies": [
        { "name": "ScorePlay", "ats": "ashby", "board": "scoreplay" },
        { "name": "Ready", "ats": "ashby", "board": "ready" }
      ],
      "title_include": ["product manager", "product owner"],
      "title_exclude": ["intern", "associate", "junior"],
      "location_include": [],
      "max_per_run": 30
    },
    "rtj": { "enabled": false, "token_env": "RTJ_API_TOKEN", "hours": 24, "title_exclude": [] },
    "linkedin_alerts": {
      "enabled": false,
      "sender": "jobalerts-noreply@linkedin.com",
      "first_run_hours": 48, "overlap_hours": 24,
      "max_fetch": 40, "delay_ms": 3000,
      "title_exclude": ["intern", "junior"], "location_exclude_regex": ""
    },
    "outcomes": {
      "enabled": false,
      "query": "newer_than:3d -category:promotions -category:social",
      "max_emails": 50, "overlap_hours": 24, "account_index": 0,
      "model": null
    },
    "drop_dir": {
      "enabled": false,
      "dir": "/home/youruser/jobpilot-drop",
      "settle_sec": 60,
      "move_processed_to": "/home/youruser/jobpilot-drop/processed",
      "max_fetches_per_run": 40
    }
  },
  "gates": {
    "_comment": "Hard rules every source applies before a job is queued. Every key is optional; remove one to turn its check off.",
    "user": { "citizenships": [], "work_authorization": ["ES"] },
    "languages": ["en", "es"],
    "onsite_countries": ["ES"],
    "remote": { "accept_worldwide": true, "accept_regions": ["Europe*", "EU", "EEA", "EMEA"] },
    "sponsorship_refusal_phrases": ["without sponsorship", "no visa sponsorship", "must be authorized to work in"],
    "must_reside_phrases": [],
    "headcount": { "demote_over": null, "reject_over": null, "demote_unless": ["remote_worldwide", "remote_region", "sponsorship"] },
    "companies": { "exclude": [], "agencies": [] },
    "industries": { "exclude": [] }
  },
  "delivery": { "telegram": { "enabled": false, "token_env": "TELEGRAM_BOT_TOKEN", "chat_id_env": "TELEGRAM_CHAT_ID" } },
  "pack": { "enabled": true, "pdf": "auto" }
}

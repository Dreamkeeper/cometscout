{
  "_comment": "Copy to settings.json. Secrets (tokens) go in .env, never here. Every source is optional: enable what you have.",
  "candidate_name": "Alex Rivera",
  "timezone": "Europe/Madrid",
  "schedule": { "days": [1, 2, 3, 4, 5, 6, 7], "time": "18:00" },
  "llm": {
    "provider": "claude",
    "model": "sonnet",
    "pack_model": "opus",
    "timeout_sec": 300
  },
  "decoder": { "cap": 30, "prompt_file": null },
  "queue": { "dedupe_days": 60, "aliases": [], "role_stopwords": [] },
  "picks": {
    "per_day": 2, "window_days": 14, "max_shown": 3,
    "exclude_location_regex": "", "exclude_onsite_location_regex": "",
    "shape_bonus": [],
    "prep": { "days_before": 2, "max": 1, "verdicts": ["strong-fit"], "max_priority": 1, "fresh_days": 2 }
  },
  "sources": {
    "ats_boards": {
      "enabled": true,
      "companies": [
        { "name": "ScorePlay", "ats": "ashby", "board": "scoreplay" },
        { "name": "Ready", "ats": "ashby", "board": "ready" }
      ],
      "title_include": ["product manager", "product owner"],
      "title_exclude": ["intern", "associate", "junior"],
      "location_include": [],
      "max_per_run": 30
    },
    "rtj": { "enabled": false, "token_env": "RTJ_API_TOKEN", "hours": 24, "title_exclude": [] },
    "linkedin_alerts": {
      "enabled": false,
      "sender": "jobalerts-noreply@linkedin.com",
      "first_run_hours": 48, "overlap_hours": 24,
      "max_fetch": 40, "delay_ms": 3000,
      "title_exclude": ["intern", "junior"], "location_exclude_regex": ""
    },
    "hh_alerts": {
      "enabled": false,
      "sender": "noreply@hh.ru",
      "first_run_hours": 72, "overlap_hours": 24, "max_lookback_hours": 168,
      "max_fetch": 40, "delay_ms": 3000,
      "title_include": [], "title_exclude": ["стажер", "стажёр", "intern", "junior"],
      "must_reside_phrases": [],
      "abroad_signals": [],
      "tax_residency_phrases": [],
      "city_countries": {}
    },
    "outcomes": {
      "enabled": false,
      "query": "newer_than:3d -category:promotions -category:social",
      "max_emails": 50, "overlap_hours": 24, "account_index": 0,
      "model": null
    },
    "drop_dir": {
      "enabled": false,
      "dir": "/home/youruser/cometscout-drop",
      "settle_sec": 60,
      "move_processed_to": "/home/youruser/cometscout-drop/processed",
      "max_fetches_per_run": 40
    },
    "hirify": {
      "enabled": false,
      "cookie_env": "HIRIFY_COOKIE",
      "filters": [
        { "name": "product remote", "query": "search=product%20manager&work_format=remote" }
      ],
      "max_pages_per_filter": 3,
      "max_age_days": 14,
      "delay_ms": 1500,
      "title_exclude": ["intern", "junior"]
    },
    "career_ops": {
      "enabled": false,
      "path": "/home/youruser/career-ops",
      "include_evaluated": false,
      "max_per_run": 30
    }
  },
  "gates": {
    "_comment": "Hard rules every source applies before a job is queued. Every key is optional; remove one to turn its check off.",
    "user": { "citizenships": [], "work_authorization": ["ES"] },
    "languages": ["en", "es"],
    "onsite_countries": ["ES"],
    "remote": { "accept_worldwide": true, "accept_regions": ["Europe*", "EU", "EEA", "EMEA"] },
    "sponsorship_refusal_phrases": ["without sponsorship", "no visa sponsorship", "must be authorized to work in"],
    "must_reside_phrases": [],
    "headcount": { "demote_over": null, "reject_over": null, "demote_unless": ["remote_worldwide", "remote_region", "sponsorship"] },
    "companies": { "exclude": [], "agencies": [] },
    "industries": { "exclude": [], "exclude_combos": [] }
  },
  "delivery": { "telegram": { "enabled": false, "token_env": "TELEGRAM_BOT_TOKEN", "chat_id_env": "TELEGRAM_CHAT_ID" } },
  "locale": "en",
  "pack": { "enabled": true, "pdf": "auto" },
  "tracker_export": { "enabled": false, "out": "tracker/pipeline.json" },
  "sources_report": {
    "enabled": false,
    "window_days": 30,
    "prices": {
      "rtj": { "price_month": 10, "currency": "USD", "renews": "2026-12-01", "decision": "under review" },
      "some-premium-plan": { "feed": false, "price_month": 20, "currency": "EUR" }
    }
  },
  "health": { "ping_url": "" },
  "backup": { "nightly": true, "copy_to": "", "zip_codepage": null },
  "update": { "channel": "stable", "check": true },
  "modules": {
    "_comment": "Optional modules, installed from their own projects. coach: Noam Segal's interview coach (bash deploy/modules/coach.sh); path null means a folder named interview-coach next to this one. transcribe: speech to text on this server's CPU with faster-whisper (bash deploy/modules/transcribe.sh); path null means a folder named cometscout-transcribe next to this one; language null detects it; telegram_attach sends transcript.md with the Transcript ready message; README: Transcription.",
    "coach": { "enabled": false, "path": null, "repo": "https://github.com/noamseg/interview-coach-skill.git" },
    "transcribe": { "enabled": false, "path": null, "model": "medium", "compute_type": "int8", "threads": 2, "nice": 10, "language": null, "inbox": "data/audio/inbox", "keep_audio_days": 30, "max_upload_mb": 500, "telegram_attach": true }
  }
}
